				return: () => {
					log.returned++;
					release?.();
					return Promise.resolve(undefined);
				}
			};
		},
		now: () => Promise.resolve(t.now),
		sleep: (ms) => {
			t.now += ms;
			return Promise.resolve();
		},
		rnd: () => .5,
		stopCli: () => {
			log.stops++;
			return Promise.resolve();
		},
		saveCfg: (on) => {
